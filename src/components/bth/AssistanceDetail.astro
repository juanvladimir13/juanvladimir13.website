---
const { student, assistences } = Astro.props;
---

<div class="assistence-container">
  <span>{student}</span>
  <hr>
  {
    assistences.map((assistence) => (
      <div class="assistence">
        <p>{assistence.day}</p>
        <p>
          <strong>Ingreso:</strong> {assistence.entry}
        </p>
        <p>
          <strong>Obs:</strong> {assistence.entryDetail}
        </p>
        <p>
          <strong>Salida:</strong> {assistence.exit}
        </p>
        <p>
          <strong>Obs:</strong> {assistence.exitDetail}
        </p>
        <hr />
      </div>
    ))
  }
</div>

<style>
  .assistence-container {
    color: var(--green-950);
    font-size: var(--text-17);
  }

  .assistence-container > span {
    font-size: var(--text-19);
    font-weight: 500;
    text-transform: uppercase;
  }

  .assistence {
    padding-left: 0px;
    line-height: 1.2;
  }
</style>
