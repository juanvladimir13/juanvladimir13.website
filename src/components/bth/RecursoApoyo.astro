---
const {
  title,
  description,
  tecnologies,
  path_file,
  github,
  donwload_name_file,
} = Astro.props;
---

<div class="container">
  <div class="project">
    <p class="title">{title}</p>
    <p class="description">{description}</p>
    <div class="tecnologies">
      {tecnologies.map((item) => <span class="badge">{item}</span>)}
    </div>
  </div>

  <div class="source">
    {
      (
        <a href={path_file} target="_blank" download={donwload_name_file}>
          <img src="/icons/download.svg" height="24" width="24" />
        </a>
      )
    }
    {
      (
        <a href={github} target="_blank">
          <img
            src="https://res.cloudinary.com/juanvladimir13/image/upload/v1712330060/icon/chrome.png"
            alt="icon"
          />
        </a>
      )
    }
  </div>
</div>

<style>
  .container {
    padding: 0px 0px 0px var(--padding-sm);
    color: var(--green-950);
    display: grid;
    grid-template-columns: 1fr 40px;
    margin-bottom: 15px;
  }

  .title {
    font-size: var(--text-18);
    font-weight: 500;
    line-height: 1;
    margin-bottom: 2px;
  }

  .description {
    font-size: var(--text-17);
    line-height: 1;
  }

  .tecnologies {
    margin: 5px 0px;
    print-color-adjust: exact;
  }

  .badge {
    padding: 4px 10px;
    margin-right: 3px;
    border-radius: 8px;
    background-color: var(--green-700);
    color: var(--green-50);
    font-size: var(--text-14);
    font-weight: 500;
    line-height: 1;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .source {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: end;
  }

  .source > a > img {
    width: 32px;
  }
</style>
