---
const { title, contents, uuid } = Astro.props;
---

<div class="bg-container">
  <h3 class="sub-title" id={uuid}>{title}</h3>
  <ul>
    {
      contents.map((content) => (
        <li>
          <span>{content.title}</span>
          {content.path_file || content.donwload_name_file ? (
            <a href={content.path_file} download={content.donwload_name_file}>
              <img src="/icons/download.svg" height="24" width="24" />
            </a>
          ) : (
            <a href="javascript:void(0);">
              <img src="/icons/download.svg" height="24" width="24" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-8);
    line-height: var(--lh-125);
    margin-bottom: 5px;
    padding-left: 10px;
  }

  .bg-container {
    background-color: var(--green-50);
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 10px;
    border: 1px solid var(--green-200);
  }
</style>
