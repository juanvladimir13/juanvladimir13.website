---
import AssistanceDetail from "./AssistanceDetail.astro";

const student = 'juan vladimir ramirez flores'
const assistances13 = []
const assistances = [
  {day: 'Lunes 27 abril', entry: '14:00', entryDetail: '', exit: '18:15', exitDetail: ''},
  {day: 'Martes 28 abril', entry: '14:00', entryDetail: 'Actividad en el colegio con su docente', exit: '18:15', exitDetail: ''},
  {day: 'Miercoles 29 abril', entry: '14:00', entryDetail: '', exit: '18:15', exitDetail: 'Reunion de los docentes del modulo'},
  {day: 'Jueves 30 abril', entry: '14:00', entryDetail: '', exit: '18:15', exitDetail: ''},
  {day: 'Lunes 2 mayo', entry: '14:00', entryDetail: '', exit: '18:15', exitDetail: ''}
];

const {title} = Astro.props;
---

<div class="container-fluid">
  <h3 class="sub-title">{title}</h3>
  <div class="form">
    <div class="criterio">
      <label>
        <input type="radio" name="course" value="quinto" id="quinto" checked />
        Ver asistencia
      </label>
      <label>
        <input type="radio" name="course" value="sexto" id="sexto" /> Ver Notas
      </label>
    </div>
    <span>Datos del estudiante</span>
    <input type="number" placeholder="Carnet" min="1000000" required />
    <input type="number" placeholder="Celular" min="1000000" required />
    <button>Ver</button>
  </div>
  <br />
  <div class="student">

  </div>

  { (student && assistances) && <AssistanceDetail student={student} assistences={assistances} /> }
</div>

<script is:inline>
  const buttonSearch = document.querySelector('button');
  buttonSearch.addEventListener('click', ()=>{
    alert('En construccion');
  })
</script>

<style>
  h3 {
    margin-bottom: 10px;
  }

  .criterio {
    margin-bottom: 0px;
    text-align: center;
    font-size: var(--text-base);
  }

  .form {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .form > span {
    font-weight: 500;
    font-size: var(--text-base);
  }

  .form > input[type=number] {
    margin-top: 5px;
    margin-bottom: 5px;
    font-size: var(--text-20);
    padding: 5px 5px;
    line-height: 1;
    border-style: solid;
    border-radius: 10px;
    border-color: var(--green-600);
    color: var(--green-950);
    text-align: center;
    width: 280px;
  }

  .form > input[type=number]:focus {
    outline: none;
    border-color: var(--green-600);
  }

  .form > button {
    background-color: var(--green-500);
    color: var(--green-50);
    border: none;
    border-radius: 10px;
    min-height: 35px;
    font-size: var(--text-20);
    width: 290px;
    cursor: pointer;
  }

  .form > button:hover {
    background-color: var(--green-600);
  }
</style>
