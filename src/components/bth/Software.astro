---
const {categoria} = Astro.props;
---
<div>
  <h2> {categoria.name} </h2>
  <hr />
{categoria.software.map((software)=> (
  
  <div class="software">
    <img src="/icons/bars.svg" height="24" width="24" alt="..." />
    <div>
      <h4>{software.name}</h4>
      <p>{software.description}</p>
    </div>
    <a href={software.download} target="_blank">
      <img src="/icons/download.svg" alt="" srcset="" height="24" width="24" />
    </a>
  </div>
))}
</div>

<style>
  .software {
    display: grid;
    grid-template-columns: 10% 75% 15%;
    column-gap: 10px;
    align-items: center;
  }

  .software > img {
    justify-self: center;
  }

  .software > a {
    justify-self: center;
  }

  h4 {
    color: var(--green-950);
    font-size: var(--text-base);
    font-weight: 500;
  }

  h2 {
    margin-top: 3px;
    color: var(--green-950);
    font-size: var(--text-base);
    font-weight: 500;
  }

  p {
    font-size: var(--text-base);
    line-height: 1;
    color: var(--green-950);
    margin-bottom: 3px;
  }


@media screen and (min-width: 769px) {
  .software{
    grid-template-columns: 5% 85% 10%;
  }
}
</style>
