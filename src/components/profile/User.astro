---
const { name, username, about, image } = Astro.props;
---

<div class="card">
  <div class="user">
    <picture>
      <img src={image} loading="lazy" alt="user" />
    </picture>
    <h1><span>{name}</span><span>{username}</span></h1>
  </div>
  <p class="description">{about}</p>
</div>

<style>
  .card {
    margin-bottom: var(--gap-12);
    max-width: var(--width-md);
    padding: 0px var(--padding-sm);
  }

  .user {
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-12);
  }

  .user > picture > img {
    width: 90px;
    border-radius: 50%;
  }

  .user > h1 {
    line-height: var(--lh-100);
  }

  .user > h1 > span:nth-child(1) {
    color: var(--green-950);
    display: block;
    font-size: var(--fs-24);
    font-weight: var(--fw-500);
  }

  .user > h1 > span:nth-child(2) {
    color: var(--green-900);
    display: block;
    font-size: var(--fs-18);
    font-weight: 400;
  }

  .description {
    color: var(--green-950);
    font-size: var(--fs-16);
    line-height: var(--lh-100);
    text-align: center;
    margin-top: var(--gap-8);
  }

  @media screen and (min-width: 576px) {
    .card {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0px auto;
      margin-bottom: var(--gap-12);
      padding: 0px;
    }

    .user {
      padding-right: 0px;
      width: 175px;
      max-width: 175px;
      flex-direction: column;
      gap: var(--gap-4);
    }

    .description {
      width: 50%;
      margin-top: 0px;
    }
  }

  @media screen and (min-width: 769px) {
    .user {
      padding: 0px;
      width: 200px;
      max-width: 200px;
    }

    .description {
      padding: 0px;
    }
  }
</style>
