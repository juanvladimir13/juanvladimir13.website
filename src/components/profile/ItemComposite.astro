---
const { title, datas } = Astro.props;
const [principal, _] = title.split("|");
const complement = title.substring(title.indexOf("|"));
---

<div class="item">
  <p><strong>{principal}</strong> {complement}</p>
  <hr />
  <div>
    {datas.map((item) => <p>{item}</p>)}
  </div>
</div>

<style>
  .item {
    padding: 3px var(--padding-sm);
    color: var(--green-950);
  }

  .item > hr {
    margin: 2px 0px 5px;
    color: var(--divider-color);
  }

  .item > p {
    font-size: var(--fs-16);
    line-height: var(--lh-100);
  }

  .item > div > p {
    padding: 0px 10px;
    font-size: var(--fs-16);
    line-height: var(--lh-100);
  }
</style>
