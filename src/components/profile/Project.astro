---
const { title, description, tecnologies, url, github } = Astro.props;
---

<div class="container">
  <p class="title">{title}</p>
  <p class="description">{description}</p>
  <div class="project">
    <div class="tecnologies">
      {tecnologies.map((item) => <span class="badge">{item}</span>)}
    </div>
    <div class="source">
      { github &&
        <a href={github}>
          <img src="https://res.cloudinary.com/juanvladimir13/image/upload/v1712330060/icon/chrome.png" alt="icon" />
        </a>
      }

      { url &&
        <a href={url}>
          <img src="https://res.cloudinary.com/juanvladimir13/image/upload/v1712330060/icon/github.png" alt="icon" />
        </a>
      }
    </div>
  </div>
</div>

<style>
  .container {
    padding: 0px var(--padding-sm);
    color: var(--green-950);
  }

  .title {
    font-size: var(--fs-18);
    font-weight: var(--fw-500);
    line-height: var(--lh-100);
    margin-bottom: 2px;
  }

  .description {
    font-size: var(--fs-16);
    line-height: var(--lh-100);
  }

  .tecnologies {
    display: flex;
    justify-content: center;
    gap: var(--gap-4);
    text-align: center;
    margin: 5px 0px;
    print-color-adjust: exact;
  }

  .badge {
    padding: 4px 10px;
    border-radius: 8px;
    background-color: var(--green-700);
    color: var(--green-50);
    font-size: var(--fs-14);
    font-weight: var(--fw-500);
    line-height: var(--lh-100);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .source {
    display: flex;
    justify-content: center;
    gap: var(--gap-4);
  }

  .source > a > img {
    width: var(--icon-32);
  }

  .project {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
    }
</style>
