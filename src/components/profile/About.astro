---
const { aboutsme } = Astro.props;
---

<div class="container-fluid about">
  <h2>Sobre mi</h2>
  <ul>
    {aboutsme.map((item:string) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .about {
    color: var(--green-950);
  }

  .about > h2 {
    font-size: var(--fs-18);
    text-transform: uppercase;
  }

  .about > ul {
    padding-left: var(--padding-sm);
    font-size: var(--fs-16);
    line-height: var(--lh-125);
  }
</style>
