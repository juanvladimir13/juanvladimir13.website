---
import RecursoNexCloud from "@components/bth/RecursoNexCloud.astro";

const { title, contents } = Astro.props;
---

<div class="bg-container">
  <h3 class="sub-title" style="margin-bottom: 5px;">{title}</h3>
  {
    contents.map(({ title, description, tecnologies, path_file, nextcloud, donwload_name_file }) => (
      <RecursoNexCloud
        title={title}
        description={description}
        tecnologies={tecnologies}
        path_file={path_file}
        donwload_name_file={donwload_name_file}
        nextcloud={nextcloud}
      />
    ))
  }
</div>

<style>
  .bg-container {
    background-color: var(--green-100);
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 10px;
    border: 1px solid var(--green-600);
  }
</style>
