---
const { title, data } = Astro.props;
---
<div class="item">
  <span class="title">{title}</span>: <span>{data}</span>
</div>
<style>
  .item {
    font-size: var(--fs-16);
    padding: 0px var(--padding-sm);
    line-height: var(--lh-125);
  }

  span {
    color: var(--green-950);
  }

  .title {
    font-weight: var(--fw-500);
  }
</style>
