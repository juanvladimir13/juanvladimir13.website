---
const { redessociales } = Astro.props;
---
<div class="container-fluid">
  <div class="container">
    {
      redessociales.map(({ username, icon, url }) => (
        <a href={url} target="_blank">
          <img src={icon} alt="icon" />
          {username}
        </a>
      ))
    }
  </div>
</div>

<style>
  .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0px;
  }

  .container > a {
    display: flex;
    align-items: center;
    gap: var(--gap-4);
    font-size: var(--fs-14);
    color: var(--green-950);
    padding: 0px 5px;
  }

  .container > a > img {
    width: var(--icon-24);
  }

  @media screen and (min-width: 576px) {
    .container {
      justify-content: space-between;
    }
  }
</style>
