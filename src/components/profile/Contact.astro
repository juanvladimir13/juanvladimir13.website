---
import type { IRedSocial } from "src/types/datatypes";

const { redessociales } = Astro.props;
---

<div class="contact">
  {
    redessociales.map(({ username, icon, url }: IRedSocial) => (
      <a href={url} target="_blank">
        <img src={icon} alt="icon" />
        {username}
      </a>
    ))
  }
</div>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    max-width: var(--width-md);
    margin-bottom: var(--gap-12);
  }

  .contact > a {
    display: flex;
    align-items: center;
    gap: var(--gap-4);
    font-size: var(--fs-14);
    color: var(--green-950);
    padding: 0px 5px;
  }

  .contact > a > img {
    width: var(--icon-24);
  }

  @media screen and (min-width: 576px) {
    .contact {
      margin-bottom: var(--gap-12);
    }
  }

  @media screen and (min-width: 768px) {
    .contact {
      justify-content: space-between;
      margin: 0px auto;
      padding: 0px var(--padding-md);
    }
  }
</style>
