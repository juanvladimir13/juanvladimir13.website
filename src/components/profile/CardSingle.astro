---
import type { IItemSingle } from "src/types/datatypes";
import ItemSingle from "./ItemSingle.astro";

const { title, datas } = Astro.props;
---

<div class="container-fluid">
  <h3 class="card-title">{title}</h3>
  {
    datas.map(({ title, content }: IItemSingle) => (
      <ItemSingle title={title} data={content} />
    ))
  }
</div>
