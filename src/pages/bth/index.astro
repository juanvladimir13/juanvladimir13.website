---
import contents from "@content/bth/contenido.yml";
import material from "@content/bth/material.yml";

import BTHLayout from "@layouts/BTHLayout.astro";

import ThemeContent from "@components/bth/ThemeContent.astro";
import CardMaterial from "@components/profile/CardMaterial.astro";
---

<BTHLayout title="BTH">
  <div class="container-fluid">
    <ThemeContent title="Contenido Base" contents={contents.shared} />

    <ThemeContent title="Contenido de apoyo" contents={contents.apoyo} />

    <ThemeContent title="Quinto" contents={contents.quinto} />

    <ThemeContent title="Sexto" contents={contents.sexto} />

    <CardMaterial title="Material de apoyo" contents={material.github} />
  </div>
</BTHLayout>
