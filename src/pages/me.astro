---
import cv from "@content/portafolio/portafolio.yml";
import tech from "@content/portafolio/technologies.yml";

import PortafolioLayout from "@layouts/PortafolioLayout.astro";

import ItemSingle from "@components/profile/ItemSingle.astro";
import ItemComposite from "@components/profile/ItemComposite.astro";
import Card from "@components/profile/Card.astro";
import Contact from "@components/profile/Contact.astro";

import User from "@components/profile/User.astro";
import About from "@components/profile/About.astro";
import Tecnology from "@components/profile/Tecnology.astro";
---

<PortafolioLayout title="Juan Vladimir | Portafolio">
  <Contact redessociales={cv.redessociales} />
  <User
    image={cv.image}
    name={cv.name}
    username={cv.username}
    about={cv.about}
  />

  <Card title="Datos personales">
    {
      cv.datospersonales.map(({ title, content }) => (
        <ItemSingle title={title} content={content} />
      ))
    }
  </Card>

  <About aboutsme={cv.aboutsme} />

  <Card title="Educación">
    {
      cv.educacion.map(({ title, data }) => (
        <ItemComposite title={title} data={data} />
      ))
    }
  </Card>

  <Card title="Experiencia como docente">
    {
      cv.experiencia.map(({ title, data }) => (
        <ItemComposite title={title} data={data} />
      ))
    }
  </Card>

  <Card title="Habilidades en Tecnologías">
    {
      tech.technologies.map(({ title, badges }) => (
        <Tecnology title={title} badges={badges} />
      ))
    }
  </Card>
</PortafolioLayout>
