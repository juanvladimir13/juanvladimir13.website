---
import PortafolioLayout from "@layouts/PortafolioLayout.astro";

import datospersonales from "@content/portafolio/datospersonales.yml";
import educacion from "@content/portafolio/educacion.yml";
import experiencia from "@content/portafolio/experiencia.yml";
import cursos from "@content/portafolio/cursos.yml";
import projects from "@content/portafolio/proyectos.yml";
import expociencia from "@content/portafolio/expociencia.yml";
import tech from "@content/portafolio/technologies.yml";

import About from "@components/profile/About.astro";
import CardSingle from "@components/profile/CardSingle.astro";
import CardComposite from "@components/profile/CardComposite.astro";
import CardTecnology from "@components/profile/CardTecnology.astro";
import CardProject from "@components/profile/CardProject.astro";
import Contact from "@components/profile/Contact.astro";
import User from "@components/profile/User.astro";
import Resume from "@components/profile/Resume.astro";
---

<PortafolioLayout title="Juan Vladimir | Portafolio">
  <Contact redessociales={datospersonales.redessociales} />

  <User
    image={datospersonales.image}
    name={datospersonales.name}
    username={datospersonales.username}
    about={datospersonales.about}
  />

  <Resume />

  <CardSingle
    title="Datos personales"
    datas={datospersonales.datospersonales}
  />

  <About aboutsme={datospersonales.aboutsme} />

  <CardComposite title="Educación" datas={educacion.educacion} />

  <CardComposite
    title="Experiencia como docente"
    datas={experiencia.experiencia}
  />
  <CardComposite title="Cursos" datas={cursos.cursos} />

  <CardProject title="Proyectos" datas={projects.projects} />

  <CardProject
    title="Participación en ferias científicas UAGRM - FICCT"
    datas={expociencia.expociencia}
  />

  <CardTecnology
    title="Habilidades en Tecnologías"
    contents={tech.technologies}
  />
</PortafolioLayout>
