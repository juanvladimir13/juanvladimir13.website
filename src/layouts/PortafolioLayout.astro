---
import BaseLayout from "./BaseLayout.astro";
const {title} = Astro.props;
---

<BaseLayout title={title}>
  <slot name="head" slot="head">
    <meta name="description" content="Página y blog personal" />
    <meta property="og:description" content="Página y blog personal" />
    <meta property="og:url" content="https://juanvladimir13.web.app/" />
    <meta property="og:title" content="Juan Vladimir | Portafolio" />
    <meta property="og:image:type" content="image/jpg" />
    <meta property="og:image:height" content="250" />
    <meta property="og:image:width" content="250" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/juanvladimir13/image/upload/v1712330060/me/profile.jpg"
    />
  </slot>

  <slot />
</BaseLayout>
