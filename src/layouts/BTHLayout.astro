---
import Materias from "@components/Materias.astro";
import BaseLayout from "./BaseLayout.astro";
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <slot name="head" slot="head">
    <meta name="description" content="Módulo Tecnológico Productivo" />
    <meta
      property="og:description"
      content="Módulo Tecnológico Productivo"
    />
    <meta property="og:url" content="https://juanvladimir13.web.app/bth/" />
    <meta property="og:title" content="BTH - Sistemas Informáticos" />
    
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:width" content="1024" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/juanvladimir13/image/upload/v1721708971/opengraph/escudo-si.png"
    />
  </slot>
  <Materias />
  <slot />
</BaseLayout>
